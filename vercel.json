{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/aqut", "destination": "/ams.html", "permanent": true },
    { "source": "/aqut/", "destination": "/ams.html", "permanent": true },
    { "source": "/aqut.html", "destination": "/ams.html", "permanent": true },
    { "source": "/prozesshandbuch", "destination": "/", "permanent": true },
    { "source": "/prozesshandbuch/", "destination": "/", "permanent": true },
    { "source": "/prozesshandbuch.html", "destination": "/", "permanent": true },
    { "source": "/demo.html", "destination": "/", "permanent": true },
    { "source": "/landingpage.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' js-de.sentry-cdn.com app.cal.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com; img-src 'self' data:; font-src 'self' fonts.gstatic.com; connect-src 'self' *.ingest.de.sentry.io qdywaenmojdxhfxqbvun.supabase.co cal.com *.cal.com; frame-src cal.com *.cal.com app.cal.com; object-src 'none'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "max-age=0, no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
