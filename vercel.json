{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/aqut", "destination": "/ams.html", "permanent": true },
    { "source": "/aqut/", "destination": "/ams.html", "permanent": true },
    { "source": "/aqut.html", "destination": "/ams.html", "permanent": true },
    { "source": "/prozesshandbuch", "destination": "/", "permanent": true },
    { "source": "/prozesshandbuch/", "destination": "/", "permanent": true },
    { "source": "/prozesshandbuch.html", "destination": "/", "permanent": true },
    { "source": "/demo.html", "destination": "/", "permanent": true },
    { "source": "/landingpage.html", "destination": "/", "permanent": true },
    { "source": "/makler.html", "destination": "/ai-roadmap.html", "permanent": true },
    { "source": "/makler", "destination": "/ai-roadmap.html", "permanent": true },
    { "source": "/ai-roadmap", "destination": "/ai-roadmap.html", "permanent": true },
    { "source": "/ai-roadmap/", "destination": "/ai-roadmap.html", "permanent": true },
    { "source": "/akut.html", "destination": "/", "permanent": false },
    { "source": "/akut", "destination": "/", "permanent": false },
    { "source": "/akut/", "destination": "/", "permanent": false },
    { "source": "/roi-praemissen", "destination": "/roi-praemissen.html", "permanent": false },
    { "source": "/roi-praemissen/", "destination": "/roi-praemissen.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' app.cal.com *.wistia.com *.wistia.net connect.facebook.net; style-src 'self' 'unsafe-inline' fonts.googleapis.com *.wistia.com *.wistia.net; img-src 'self' data: *.wistia.com *.wistia.net embed-ssl.wistia.com www.facebook.com; font-src 'self' fonts.gstatic.com; media-src 'self' blob: *.wistia.com *.wistia.net; connect-src 'self' qdywaenmojdxhfxqbvun.supabase.co cal.com *.cal.com *.wistia.com *.wistia.net www.facebook.com connect.facebook.net; frame-src cal.com *.cal.com app.cal.com *.wistia.com *.wistia.net fast.wistia.net; object-src 'none'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "max-age=0, no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
